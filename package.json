{
  "name": "outlook-reply-assistant",
  "version": "0.1.0",
  "private": true,
  "description": "Outlook web add-in that drafts replies in your style using Claude.",
  "type": "module",
  "scripts": {
    "dev:web": "vite",
    "dev:server": "tsx watch server/index.ts",
    "dev": "concurrently -n web,api -c blue,magenta \"npm:dev:web\" \"npm:dev:server\"",
    "build": "vite build",
    "certs": "office-addin-dev-certs install",
    "sideload": "office-addin-debugging start manifest.xml web"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.94.0",
    "cors": "^2.8.5",
    "dotenv": "^17.0.0",
    "express": "^5.0.0"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/node": "^22.0.0",
    "@types/office-js": "^1.0.450",
    "concurrently": "^9.0.0",
    "office-addin-debugging": "^6.0.0",
    "office-addin-dev-certs": "^2.0.0",
    "tsx": "^4.0.0",
    "typescript": "^5.6.0",
    "vite": "^7.0.0",
    "vite-plugin-mkcert": "^1.17.0"
  }
}
